{
  "name": "blackcat-darkmesh-write-ao",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ao": "npm run bundle:write",
    "bundle:write": "node scripts/build-write-bundle.js",
    "api:checkout": "node scripts/http/checkout_api_server.mjs",
    "test:checkout-adapter-contract": "node --test --test-concurrency=1 tests/http/checkout_api_server.contract.test.mjs",
    "ao:upload": "node scripts/ao-upload.js",
    "ao:spawn": "node scripts/ao-spawn.js",
    "build:bundle": "node scripts/build-write-bundle.js",
    "build:ao-wasm": "bash scripts/deploy/rebuild_wasm_from_runtime.sh",
    "smoke:wasm": "test -s dist/write/process.wasm && strings dist/write/process.wasm | grep -Fq 'function process.handle'",
    "preflight:prod": "bash scripts/preflight-prod.sh",
    "demo:publish-domain-tx": "node scripts/cli/publish_domain_demo_tx.js"
  },
  "devDependencies": {
    "@memetic-block/hyperengine": "github:memetic-block/hyperengine",
    "@permaweb/aos": "^1.2.18",
    "ao": "^0.1.1",
    "esbuild": "^0.20.2",
    "tsup": "^8.5.1",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@permaweb/ao": "git+https://github.com/permaweb/ao.git#8e23f3486bf28720d98de9d0b4ff650dbdb2077e",
    "@permaweb/ao-core-libs": "^0.0.8",
    "@permaweb/aoconnect": "^0.0.93",
    "arbundles": "^0.11.2",
    "arweave": "^1.15.7",
    "node-fetch": "^3.3.2"
  },
  "overrides": {
    "axios": "1.14.0"
  }
}
